{
  "name": "bridgeview-ais",
  "version": "1.0.0",
  "description": "Real-time maritime tracking application for vessel traffic near the Blue Water Bridge using AIS data",
  "author": "Thomas McKnight",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tmcknight/bridgeview-ais.git"
  },
  "homepage": "https://github.com/tmcknight/bridgeview-ais",
  "bugs": {
    "url": "https://github.com/tmcknight/bridgeview-ais/issues"
  },
  "keywords": [
    "ais",
    "maritime",
    "ship-tracking",
    "vessel-tracking",
    "maplibre",
    "react",
    "websocket",
    "real-time"
  ],
  "engines": {
    "node": ">=26"
  },
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env server/server.js & vite --config config/vite.config.ts",
    "build": "npm run tsc -- -b && vite build --config config/vite.config.ts",
    "lint": "eslint --config config/eslint.config.js .",
    "preview": "vite preview --config config/vite.config.ts",
    "server": "node --env-file=.env server/server.js",
    "test": "vitest --config config/vitest.config.ts",
    "test:ui": "vitest --ui --config config/vitest.config.ts",
    "test:run": "vitest run --config config/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config config/vitest.config.ts",
    "tsc": "node node_modules/typescript7/bin/tsc"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/vite": "^4.1.18",
    "maplibre-gl": "^5.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.0",
    "tailwindcss": "^4.1.18",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.2.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.3.0",
    "jsdom": "^30.1.3",
    "mock-socket": "^9.3.1",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.72.1",
    "typescript7": "npm:typescript@~7.0.2",
    "vite": "^7.2.4",
    "vitest": "^5.0.5"
  }
}
