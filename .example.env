# AIS Stream API Key
# Get your API key from https://aisstream.io/
AISSTREAM_API_KEY=your_aisstream_api_key_here

# AIS feeds to use (optional), comma-separated; a report heard by more than one is sent once
# aisstream: AISStream.io (needs AISSTREAM_API_KEY)
# local:     local SDR receiver, via AIS-catcher's TCP JSON output (LOCAL_AIS_HOST, LOCAL_AIS_PORT)
# aishub:    AISHub's API, polled once a minute (needs AISHUB_API_KEY)
# Default: aisstream,local
AIS_SOURCES=aisstream,local

# AISHub API key (optional; AISHub's docs call it a username)
# AISHub gives API access to stations that share their AIS feed: https://www.aishub.net/join-us
# AISHUB_API_KEY=

# Local AIS-catcher TCP JSON stream (used when AIS_SOURCES includes local)
# Start AIS-catcher with: -S 5012 MSGFORMAT JSON_FULL
# In Docker, use host.docker.internal to reach AIS-catcher on the host
LOCAL_AIS_HOST=127.0.0.1
LOCAL_AIS_PORT=5012
# AIS-catcher's web view (its -N option), linked from the status menu
# LOCAL_AIS_WEB_URL=http://127.0.0.1:8100

# Shared ship log file (optional)
# The server logs ships passing under the bridge here for every client
# Default: data/ship-log.json (in Docker: /app/data/ship-log.json on the ship-log volume)
# SHIP_LOG_FILE=data/ship-log.json

# Ship details database (optional)
# SQLite file where the server keeps each ship's latest details (name, destination, size)
# Default: data/bridgeview.db (in Docker: /app/data/bridgeview.db on the ship-log volume)
# DB_FILE=data/bridgeview.db

# Ship data admin (optional)
# Password for the page that corrects ship details and manages their photos; off when unset.
# Uploaded photos go in PHOTOS_DIR (default: a photos folder next to DB_FILE)
# ADMIN_PASSWORD=
# PHOTOS_DIR=data/photos
# Or keep uploads in a Cloudflare R2 bucket, served from its public custom domain
# (all five, or none). The API token needs Object Read & Write on the bucket.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# PHOTOS_PUBLIC_URL=https://photos.example.com

# Aircraft layer (optional)
# The server polls an ADS-B feed every 5 seconds and shows aircraft on the map
# Default: adsb.fi's free open-data API, 40 NM around the bridge. For a local receiver, point
# ADSB_URL at readsb/tar1090's aircraft.json (e.g. http://127.0.0.1:8080/data/aircraft.json)
# AIRCRAFT_TRACKING=true
# ADSB_URL=https://opendata.adsb.fi/api/v2/lat/42.9982/lon/-82.423/dist/40

# Ship cam lookup (optional)
# A YouTube Data API v3 key. With it, the server finds the Port Huron cam's live video on
# its channel, so the cam keeps working when the stream restarts with a new video ID.
# Without it, the cam uses the video ID in src/constants/shipCams.ts
# YOUTUBE_API_KEY=

# iOS bridge alerts (optional)
# Push notifications and Live Activities for the iOS app (ios/), sent when a ship is about
# 10 minutes from the bridge. Needs an APNs auth key (.p8) from developer.apple.com.
# APNS_KEY is the .p8 file's contents (newlines may be written as \n); APNS_KEY_FILE, its path
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_KEY=
# APNS_KEY_FILE=

# Server Port (optional)
# Port for the WebSocket proxy server
# Default: 3001
PORT=3001

# Trust the reverse proxy's X-Real-IP header for per-IP rate limits (optional)
# Set only when nothing but the proxy can reach the server; Docker sets it for you
# TRUST_PROXY=false

# Most WebSocket connections allowed from one IP address (optional)
# Everyone behind the same router shares an IP, so allow a few tabs per person
# Default: 20
# MAX_CONNECTIONS_PER_IP=20

# WebSocket Authentication Token (optional, recommended for production)
# If set, clients must provide this token when connecting to the WebSocket proxy
# Leave empty for local development (no authentication required)
# For production, generate a secure random token
WS_AUTH_TOKEN=

# WebSocket Proxy URL (optional)
# Used by the Vite frontend to connect to the WebSocket proxy
# IMPORTANT: This must match the PORT above (ws://localhost:PORT)
# For production, use your deployed proxy URL (e.g., wss://your-domain.com)
# Default: ws://localhost:3001 in development; /ws on the page's own host in a production build
VITE_WS_PROXY_URL=ws://localhost:3001

# Frontend WebSocket Authentication Token (optional, must match WS_AUTH_TOKEN above)
# If the server requires authentication, set this to the same value as WS_AUTH_TOKEN
# Leave empty for local development if server authentication is disabled
VITE_WS_AUTH_TOKEN=

# Vessel Notification Service (optional)
# Sends ntfy push notifications and/or webhooks when vessels pass watch points
# See services/vessel-notifier/README.md for details

# ntfy topic name (set this and/or WEBHOOK_URL)
NTFY_TOPIC=bridgeview-ais

# ntfy server URL (default: https://ntfy.sh)
NTFY_SERVER=https://ntfy.sh

# ntfy access token (optional, for authenticated topics)
NTFY_TOKEN=

# Webhook URL that receives a JSON POST for each passage (optional)
WEBHOOK_URL=

# Secret used to sign webhook bodies (X-BridgeView-Signature: sha256=<hmac>)
WEBHOOK_SECRET=

# Points to watch, as a JSON array (default: Blue Water Bridge, max 5)
# WATCH_POINTS=[{"name":"Blue Water Bridge","lat":42.9982,"lon":-82.423,"radiusNM":0.5}]

# Look up Wikidata vessel details (photo, build year, operator) for alerts, and
# store them in the server's database for the app (default: true)
VESSEL_INFO_LOOKUP=true

# Import Transport Canada's register of large vessels once a week, filling in
# build year and tonnage for Canadian ships (default: true)
VESSEL_REGISTRY=true

# Look ships up in the USCG's PSIX records (service type, flag, tonnage,
# deadweight) for US ships and foreign ships calling at US ports (default: true)
USCG_LOOKUP=true
