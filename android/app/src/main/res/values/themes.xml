<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch screen: the logo on river blue, as on iOS -->
    <style name="Theme.BridgeView.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.BridgeView</item>
    </style>

    <style name="Theme.BridgeView" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
